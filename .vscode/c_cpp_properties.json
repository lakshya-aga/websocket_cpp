{
    "version": 4,
    "configurations": [
        {
            "name": "MSYS2-UCRT64",
            "compilerPath": "C:/msys64/ucrt64/bin/g++.exe",
            "compilerArgs": [
                "-isystem",
                "C:/msys64/ucrt64/include"
            ],
            "intelliSenseMode": "windows-gcc-x64",
            "cStandard": "c17",
            "cppStandard": "c++20",
            "includePath": [
                "${workspaceFolder}/**",
                "C:/msys64/ucrt64/include"
            ],
            "defines": [
                "_WIN32_WINNT=0x0A00"
            ],
            "browse": {
                "path": [
                    "${workspaceFolder}",
                    "C:/msys64/ucrt64/include"
                ],
                "limitSymbolsToIncludedHeaders": true
            }
        }
    ]
}
